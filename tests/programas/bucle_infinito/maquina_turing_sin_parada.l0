// BUCLE
// Simulación de la máquina de Turing «fuga a la derecha» con entrada w = ε
// Estados: A=0; parada = 1. Alfabeto de cinta: 0..1.
int estado = 0;
int cur = 0;
int izq = 0;
int der = 0;
int pasos = 0;
while (estado != 1) {
    if (estado == 0) {
        if (cur == 0) {
            // δ(A, 0) = (A, 0, R)
            cur = 0;
            izq = izq * 2 + cur;
            cur = der % 2;
            der = der / 2;
            estado = 0;
            pasos = pasos + 1;
        } else if (cur == 1) {
            estado = 1; // sin transición: M se detiene
        }
    }
}
