// SALIDA: 6 14
// Simulación de la máquina de Turing «castor afanoso de 3 estados» con entrada w = ε
// Estados: A=0, B=1, C=2; parada = 3. Alfabeto de cinta: 0..1.
int estado = 0;
int cur = 0;
int izq = 0;
int der = 0;
int pasos = 0;
while (estado != 3) {
    if (estado == 0) {
        if (cur == 0) {
            // δ(A, 0) = (B, 1, R)
            cur = 1;
            izq = izq * 2 + cur;
            cur = der % 2;
            der = der / 2;
            estado = 1;
            pasos = pasos + 1;
        } else if (cur == 1) {
            // δ(A, 1) = (H, 1, R)
            cur = 1;
            izq = izq * 2 + cur;
            cur = der % 2;
            der = der / 2;
            estado = 3;
            pasos = pasos + 1;
        }
    } else if (estado == 1) {
        if (cur == 0) {
            // δ(B, 0) = (C, 0, R)
            cur = 0;
            izq = izq * 2 + cur;
            cur = der % 2;
            der = der / 2;
            estado = 2;
            pasos = pasos + 1;
        } else if (cur == 1) {
            // δ(B, 1) = (B, 1, R)
            cur = 1;
            izq = izq * 2 + cur;
            cur = der % 2;
            der = der / 2;
            estado = 1;
            pasos = pasos + 1;
        }
    } else if (estado == 2) {
        if (cur == 0) {
            // δ(C, 0) = (C, 1, L)
            cur = 1;
            der = der * 2 + cur;
            cur = izq % 2;
            izq = izq / 2;
            estado = 2;
            pasos = pasos + 1;
        } else if (cur == 1) {
            // δ(C, 1) = (A, 1, L)
            cur = 1;
            der = der * 2 + cur;
            cur = izq % 2;
            izq = izq / 2;
            estado = 0;
            pasos = pasos + 1;
        }
    }
}
int unos = 0;
if (cur != 0) {
    unos = 1;
}
while (izq != 0) {
    if (izq % 2 != 0) {
        unos = unos + 1;
    }
    izq = izq / 2;
}
while (der != 0) {
    if (der % 2 != 0) {
        unos = unos + 1;
    }
    der = der / 2;
}
print(unos);
print(pasos);
